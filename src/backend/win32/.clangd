# This directory is a Windows backend compiled by mingw, which is what a
# Linux clangd needs told: without a target and mingw's headers it cannot find
# windows.h and reports the whole file as broken. The cross build is the
# authority (./build.sh win64); this is so the editor agrees with it.
CompileFlags:
  Add:
    - --target=x86_64-pc-windows-gnu
    - -isystem
    - /usr/x86_64-w64-mingw32/include
    - -D_WIN32_WINNT=0x0A00
    - -DWINVER=0x0A00
    - -D__USE_MINGW_ANSI_STDIO=1
