{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/style-check.sh 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking house style"
          }
        ]
      }
    ]
  }
}
