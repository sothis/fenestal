# The testbed's scenes are compiled per renderer, and the build tells them
# which ones it has (SCENE_HAS_<API>); without one it is an #error and nothing
# else in the file is read. A Linux tree draws with Vulkan and OpenGL, which is
# what the editor here should see.
#
# The -I flags repeat the tree's, since a .clangd takes the place of
# compile_flags.txt for the files below it rather than adding to it. They are
# what the scene files need and src/core/.clangd's list does not cover: the
# generated shader headers live in the *build's* testbed directory, beside the
# testbed's own, and it is scene_vulkan.c and scene_gl.c -- which include them
# and <vulkan/vulkan.h> -- that a parser without them reports as broken.
CompileFlags:
  Add:
    - -DSCENE_HAS_VULKAN
    - -DSCENE_HAS_GL
    - -DFNL_STATIC
    - -I/home/json/ws/fenestal/include
    - -I/home/json/ws/fenestal/testbed
    - -I/home/json/ws/fenestal/build/linux/release/testbed

# The two scenes that are not this machine's are one directory with the rest,
# so they get their flags from a condition rather than a directory of their
# own as src/renderer/d3d12/ and src/renderer/metal/ do. The cross builds are
# the authority (./build.sh win64, ./build.sh macos); these are so the editor
# agrees with them.

# Direct3D 12, compiled by mingw: without a target and mingw's headers a Linux
# clangd cannot find d3d12.h and reports the whole file as broken. The
# generated dir is the *win64* tree's, where dxil/ is made -- the Linux tree
# translates for Vulkan and OpenGL only.
---
If:
  PathMatch: scene_d3d12\.c
CompileFlags:
  Add:
    - --target=x86_64-pc-windows-gnu
    - -isystem
    - /usr/x86_64-w64-mingw32/include
    - -D_WIN32_WINNT=0x0A00
    - -DWINVER=0x0A00
    - -D__USE_MINGW_ANSI_STDIO=1
    - -I/home/json/ws/fenestal/build/win64/release/testbed

# Metal, compiled by clang against Apple's SDK, which a Linux clangd has to be
# told about. The path is what `python3 tools/macos_sdk.py --path` answers, and
# no -x: clangd refuses it in a config (.m is Objective-C to clang already).
#
# -F as well as -isysroot: `<Metal/Metal.h>` is found through the framework
# search path and not the SDK's include path, so the sysroot alone leaves it
# unresolved.
---
If:
  PathMatch: scene_metal\.m
CompileFlags:
  Add:
    - --target=x86_64-apple-darwin
    - -isysroot
    - /home/json/.local/state/fenestal/macos-sdk/MacOSX26.5.sdk
    - -F
    - /home/json/.local/state/fenestal/macos-sdk/MacOSX26.5.sdk/System/Library/Frameworks
    - -D__APPLE__
    - -I/home/json/ws/fenestal/build/macos/release/testbed
